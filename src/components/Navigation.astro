---
const currentPath = Astro.url.pathname;
const isActive = (path: string) => path === '/' ? currentPath === '/' : currentPath.startsWith(path);
---

<nav class="main-nav">
  <div class="nav-container">
    <a href="/" class="nav-brand" aria-label="KUEPER.COM Startseite">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <rect x="8" y="8" width="8" height="8" transform="rotate(45 12 12)" stroke="currentColor" stroke-width="1.5" />
        <circle cx="12" cy="12" r="1.5" fill="currentColor" />
      </svg>
      <span class="nav-title">KUEPER.COM</span>
    </a>

    <div class="nav-menu">
      <a href="/" class={isActive('/') ? 'nav-link active' : 'nav-link'}>Start</a>
      <a href="/kue" class={isActive('/kue') ? 'nav-link active' : 'nav-link'}>Archiv</a>
      <a href="/ueber" class={isActive('/ueber') ? 'nav-link active' : 'nav-link'}>Über das Archiv</a>
      <a href="/dokumentenklassen" class={isActive('/dokumentenklassen') ? 'nav-link active' : 'nav-link'}>Dokumentenklassen</a>
    </div>

    <div class="nav-lang" aria-label="Sprachauswahl">
      <span class="lang-active">DE</span><span>/</span><span class="lang-disabled">EN</span>
    </div>
  </div>
</nav>

<footer class="site-footer">
  <span class="footer-copy">© {new Date().getFullYear()} Thomas Peter Küper</span>
  <div class="footer-links">
    <a href="/impressum">Impressum</a>
    <a href="/datenschutz">Datenschutz</a>
    <a href="/nutzungsbedingungen">Nutzungsbedingungen</a>
    <a href="/ki-transparenz">KI-Transparenz</a>
  </div>
</footer>

<style>
  .main-nav { position: sticky; top: 0; z-index: 1000; background: rgba(250,250,250,.97); backdrop-filter: blur(12px); border-bottom: 0.5px solid #e5e5e5; }
  @media (prefers-color-scheme: dark) { .main-nav { background: rgba(15,15,15,.97); border-bottom-color: #2a2a2a; } }
  .nav-container { max-width: 860px; margin: 0 auto; padding: 0 2rem; height: 52px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .nav-brand { display: flex; align-items: center; gap: 8px; text-decoration: none; color: inherit; font-size: 12px; font-weight: 500; letter-spacing: 0.1em; text-transform: uppercase; }
  .nav-title { }
  .nav-menu { display: flex; gap: 1.75rem; }
  .nav-link { font-size: 13px; color: #666; text-decoration: none; transition: color .15s; }
  .nav-link:hover, .nav-link.active { color: #111; }
  .nav-link.active { border-bottom: 1.5px solid #111; padding-bottom: 1px; }
  @media (prefers-color-scheme: dark) { .nav-link { color: #999; } .nav-link:hover, .nav-link.active { color: #f0f0f0; } .nav-link.active { border-bottom-color: #f0f0f0; } }
  .nav-lang { font-size: 12px; color: #999; font-family: 'JetBrains Mono', monospace; letter-spacing: 0.05em; }
  .lang-active { color: #111; font-weight: 500; }
  @media (prefers-color-scheme: dark) { .lang-active { color: #f0f0f0; } }
  .site-footer { border-top: 0.5px solid #e5e5e5; padding: 1.25rem 2rem; }
  @media (prefers-color-scheme: dark) { .site-footer { border-top-color: #2a2a2a; } }
  .footer-copy { font-size: 12px; color: #999; font-family: 'JetBrains Mono', monospace; }
  .footer-links { display: flex; gap: 1.25rem; flex-wrap: wrap; }
  .footer-links a { font-size: 12px; color: #999; text-decoration: none; }
  .footer-links a:hover { color: #555; }
</style>
