---
import Navigation from '../components/Navigation.astro';
---

<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Impressum — KUEPER.COM</title>
  <link rel="stylesheet" href="/styles/fonts.css">
  <link rel="stylesheet" href="/styles/homepage.css">
  <style>
    .legal-page { max-width: 680px; margin: 0 auto; padding: 3rem 2rem 6rem; }
    .legal-page h1 { font-family: 'Source Serif Pro', Georgia, serif; font-size: 1.75rem; font-weight: 400; margin-bottom: 2.5rem; padding-bottom: 1rem; border-bottom: 0.5px solid var(--border, #e5e5e5); color: var(--text-primary, #111); }
    .legal-section { margin-bottom: 2rem; }
    .legal-section h2 { font-size: 11px; text-transform: uppercase; letter-spacing: 0.12em; color: var(--text-muted, #999); font-family: 'JetBrains Mono', monospace; margin-bottom: 0.75rem; }
    .legal-section p { font-size: 15px; color: var(--text-secondary, #555); line-height: 1.8; }
    .legal-section a { color: var(--text-primary, #111); }
    .legal-section a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <Navigation />
  <main class="legal-page">
    <h1>Impressum</h1>

    <section class="legal-section">
      <h2>Angaben gemäß § 5 TMG</h2>
      <p>
        Thomas Peter Küper<br>
        Mörfelder Landstraße 103<br>
        60598 Frankfurt am Main<br>
        Deutschland
      </p>
    </section>

    <section class="legal-section">
      <h2>Kontakt</h2>
      <p>E-Mail: <a href="mailto:t.kueper@camaleo.de">t.kueper@camaleo.de</a></p>
    </section>

    <section class="legal-section">
      <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>
      <p>
        Thomas Peter Küper<br>
        Mörfelder Landstraße 103<br>
        60598 Frankfurt am Main
      </p>
    </section>

    <section class="legal-section">
      <h2>Urheberrecht</h2>
      <p>
        Alle Inhalte dieser Website — einschließlich wissenschaftlicher Dokumente, theoretischer Frameworks,
        philosophischer Konzepte (insbesondere das AVI-Modell und die Omnizedenz-Philosophie) sowie aller
        fiktionalen Universen — sind geistiges Eigentum von Thomas Peter Küper.
      </p>
      <p style="margin-top: 0.75rem;">
        Die durch den Seitenbetreiber erstellten Inhalte unterliegen dem deutschen Urheberrecht.
        Vervielfältigung, Bearbeitung und Verbreitung bedürfen der schriftlichen Zustimmung.
      </p>
    </section>
  </main>
</body>
</html>
